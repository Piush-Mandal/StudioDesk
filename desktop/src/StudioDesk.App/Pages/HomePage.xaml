<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StudioDesk.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="48,32" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock x:Name="Greeting" Style="{StaticResource DisplayTextBlockStyle}" />
            <TextBlock x:Name="Tagline" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Margin="0,32,0,0" Padding="24" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Ready when you are" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Features are on the way. Your data stays on this PC, encrypted and private." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
