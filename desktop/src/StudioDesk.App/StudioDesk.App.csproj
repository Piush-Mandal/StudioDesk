<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>StudioDesk.App</RootNamespace>
    <AssemblyName>StudioDesk</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged .exe installed by our own installer, with everything bundled -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Security: compile to native machine code (no decompilable .NET IL), trim unused code -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StudioDesk.Core\StudioDesk.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RepoDesktopDir>$(MSBuildThisFileDirectory)..\..\</RepoDesktopDir>
    <DataKeyFile>$(RepoDesktopDir)secrets\data.key</DataKeyFile>
    <PackerCmd>dotnet run --project "$(RepoDesktopDir)tools\StudioDesk.Packer" -c Release --</PackerCmd>
    <EmbeddedKeysFile>$(IntermediateOutputPath)EmbeddedKeys.g.cs</EmbeddedKeysFile>
  </PropertyGroup>

  <!-- Embed the secret data key (from secrets\data.key or the STUDIODESK_DATA_KEY env var) at build time -->
  <Target Name="EmbedDataKey" BeforeTargets="BeforeBuild">
    <Exec Command="$(PackerCmd) emit-key &quot;$(DataKeyFile)&quot; &quot;$(EmbeddedKeysFile)&quot;" />
    <ItemGroup>
      <Compile Include="$(EmbeddedKeysFile)" />
    </ItemGroup>
  </Target>

  <!-- Encrypt desktop\assets\* into Data\*.sdpak next to the .exe -->
  <Target Name="PackDataAfterBuild" AfterTargets="Build">
    <Exec Command="$(PackerCmd) pack &quot;$(RepoDesktopDir)assets&quot; &quot;$(OutDir)Data&quot; &quot;$(DataKeyFile)&quot;" />
  </Target>
  <Target Name="PackDataAfterPublish" AfterTargets="Publish">
    <Exec Command="$(PackerCmd) pack &quot;$(RepoDesktopDir)assets&quot; &quot;$(PublishDir)Data&quot; &quot;$(DataKeyFile)&quot;" />
  </Target>
</Project>
